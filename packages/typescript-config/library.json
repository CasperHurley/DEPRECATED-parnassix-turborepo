{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    /* For dependency-light, framework-free packages (no React, no DOM).
       `module` and `moduleResolution` come from base.json. */
    "target": "ES2022",
    "lib": ["ES2022"],
    "noEmit": true,
    "resolveJsonModule": true
  },
  "exclude": ["node_modules"]
}
