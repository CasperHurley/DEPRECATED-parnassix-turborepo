# Copy to .env. Every value here is a default; none is required to run locally.

PARNASSIX_REDIS_URL=redis://localhost:6379
PARNASSIX_OLLAMA_BASE_URL=http://localhost:11434

# Force a hardware tier instead of detecting one.
# small | medium | large | xlarge | workstation | cluster
# PARNASSIX_TIER=xlarge

# An exo cluster's OpenAI-compatible endpoint, to pool several machines for
# GENERATION. Opt-in rather than probed: exo's head node also listens on :8000,
# so a default localhost probe could find this service's own API instead.
# PARNASSIX_EXO_BASE_URL=http://localhost:8000/v1

# Override the built-in model catalogue with your own (JSON). See the README.
# PARNASSIX_MODEL_CATALOG=./models.json

# Route hosted OpenAI traffic through a gateway (TrustGate, LiteLLM, a proxy).
# Only the base URL moves; no call site changes.
# PARNASSIX_OPENAI_BASE_URL=http://localhost:8080/v1

# Default endpoint for openai-compatible models that carry no base_url of their
# own (exo, vLLM, LM Studio).
# PARNASSIX_OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1

# AWS Bedrock. Credentials come from the standard AWS chain, not from here.
# PARNASSIX_AWS_REGION=us-east-1
# PARNASSIX_AWS_PROFILE=default

# Semantic cache. The threshold is a DISTANCE - lower is a tighter match.
# Loosening it trades correctness for hit rate, which is the wrong trade when
# a cached answer arrives carrying the previous question's citations.
PARNASSIX_SEMANTIC_CACHE_ENABLED=true
PARNASSIX_SEMANTIC_CACHE_DISTANCE_THRESHOLD=0.25
PARNASSIX_SEMANTIC_CACHE_TTL_SECONDS=3600

PARNASSIX_API_HOST=127.0.0.1
PARNASSIX_API_PORT=8000

# Only needed if a corpus is configured to use a hosted model. Doing so sends
# document text off this machine.
# PARNASSIX_OPENAI_API_KEY=
