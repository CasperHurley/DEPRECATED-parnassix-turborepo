{
  "$id": "https://aneural.dev/schema/report/0.5.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "properties": {},
      "additionalProperties": {}
    },
    "components": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/TimelineSpec"
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "data",
    "components"
  ],
  "$defs": {
    "TimelineSpec": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "source": {
          "$ref": "#/$defs/__schema1"
        },
        "kind": {
          "$ref": "#/$defs/__schema14"
        },
        "title": {
          "$ref": "#/$defs/__schema15"
        },
        "subtitle": {
          "$ref": "#/$defs/__schema16"
        },
        "description": {
          "$ref": "#/$defs/__schema17"
        },
        "scale": {
          "$ref": "#/$defs/__schema18"
        },
        "orientation": {
          "$ref": "#/$defs/__schema19"
        },
        "order": {
          "$ref": "#/$defs/__schema20"
        },
        "labelUnit": {
          "$ref": "#/$defs/__schema21"
        },
        "lineVariant": {
          "$ref": "#/$defs/__schema22"
        },
        "events": {
          "$ref": "#/$defs/__schema23"
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "events"
      ]
    },
    "__schema0": {
      "type": "string",
      "minLength": 1
    },
    "__schema1": {
      "$ref": "#/$defs/SourceRef"
    },
    "SourceRef": {
      "type": "object",
      "properties": {
        "documentId": {
          "$ref": "#/$defs/__schema2"
        },
        "nodeId": {
          "$ref": "#/$defs/__schema3"
        },
        "page": {
          "$ref": "#/$defs/__schema4"
        },
        "bbox": {
          "$ref": "#/$defs/__schema5"
        },
        "coordOrigin": {
          "$ref": "#/$defs/__schema10"
        },
        "pageSize": {
          "$ref": "#/$defs/__schema11"
        },
        "chunkId": {
          "$ref": "#/$defs/__schema12"
        },
        "quotedText": {
          "$ref": "#/$defs/__schema13"
        }
      },
      "required": [
        "documentId",
        "nodeId",
        "page"
      ]
    },
    "__schema2": {
      "type": "string",
      "minLength": 1
    },
    "__schema3": {
      "type": "string",
      "minLength": 1
    },
    "__schema4": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema5": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/$defs/BBox"
      }
    },
    "BBox": {
      "type": "object",
      "properties": {
        "l": {
          "$ref": "#/$defs/__schema6"
        },
        "t": {
          "$ref": "#/$defs/__schema7"
        },
        "r": {
          "$ref": "#/$defs/__schema8"
        },
        "b": {
          "$ref": "#/$defs/__schema9"
        }
      },
      "required": [
        "l",
        "t",
        "r",
        "b"
      ]
    },
    "__schema6": {
      "type": "number"
    },
    "__schema7": {
      "type": "number"
    },
    "__schema8": {
      "type": "number"
    },
    "__schema9": {
      "type": "number"
    },
    "__schema10": {
      "default": "bottomleft",
      "$ref": "#/$defs/CoordOrigin"
    },
    "CoordOrigin": {
      "type": "string",
      "enum": [
        "topleft",
        "bottomleft"
      ]
    },
    "__schema11": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "__schema12": {
      "type": "string"
    },
    "__schema13": {
      "type": "string"
    },
    "__schema14": {
      "type": "string",
      "const": "timeline"
    },
    "__schema15": {
      "type": "string"
    },
    "__schema16": {
      "type": "string"
    },
    "__schema17": {
      "type": "string"
    },
    "__schema18": {
      "default": "ordinal",
      "$ref": "#/$defs/TimelineScale"
    },
    "TimelineScale": {
      "type": "string",
      "enum": [
        "ordinal",
        "time"
      ]
    },
    "__schema19": {
      "default": "horizontal",
      "$ref": "#/$defs/TimelineOrientation"
    },
    "TimelineOrientation": {
      "type": "string",
      "enum": [
        "horizontal",
        "vertical"
      ]
    },
    "__schema20": {
      "default": "ascending",
      "$ref": "#/$defs/TimelineOrder"
    },
    "TimelineOrder": {
      "type": "string",
      "enum": [
        "ascending",
        "descending"
      ]
    },
    "__schema21": {
      "$ref": "#/$defs/UnitOfTime"
    },
    "UnitOfTime": {
      "type": "string",
      "enum": [
        "millisecond",
        "second",
        "minute",
        "hour",
        "day",
        "week",
        "month",
        "year"
      ]
    },
    "__schema22": {
      "$ref": "#/$defs/LineVariant"
    },
    "LineVariant": {
      "type": "string",
      "enum": [
        "solid",
        "dashed",
        "dotted",
        "none"
      ]
    },
    "__schema23": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TimelineEventSpec"
      }
    },
    "TimelineEventSpec": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema24"
        },
        "timestamp": {
          "$ref": "#/$defs/Timestamp"
        },
        "precision": {
          "$ref": "#/$defs/__schema27"
        },
        "until": {
          "$ref": "#/$defs/__schema28"
        },
        "untilPrecision": {
          "$ref": "#/$defs/__schema29"
        },
        "title": {
          "$ref": "#/$defs/__schema30"
        },
        "subtitle": {
          "$ref": "#/$defs/__schema31"
        },
        "description": {
          "$ref": "#/$defs/__schema32"
        },
        "lineVariant": {
          "$ref": "#/$defs/__schema33"
        },
        "source": {
          "$ref": "#/$defs/__schema34"
        },
        "spans": {
          "$ref": "#/$defs/__schema35"
        }
      },
      "required": [
        "id",
        "timestamp",
        "title"
      ]
    },
    "__schema24": {
      "type": "string",
      "minLength": 1
    },
    "Timestamp": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema25"
        },
        {
          "$ref": "#/$defs/__schema26"
        }
      ]
    },
    "__schema25": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema26": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "__schema27": {
      "$ref": "#/$defs/TimePrecision"
    },
    "TimePrecision": {
      "type": "string",
      "enum": [
        "year",
        "month",
        "day",
        "hour",
        "minute",
        "second",
        "millisecond"
      ]
    },
    "__schema28": {
      "$ref": "#/$defs/Timestamp"
    },
    "__schema29": {
      "$ref": "#/$defs/TimePrecision"
    },
    "__schema30": {
      "type": "string"
    },
    "__schema31": {
      "type": "string"
    },
    "__schema32": {
      "type": "string"
    },
    "__schema33": {
      "$ref": "#/$defs/LineVariant"
    },
    "__schema34": {
      "$ref": "#/$defs/SourceRef"
    },
    "__schema35": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/$defs/TimeSpan"
      }
    },
    "TimeSpan": {
      "type": "object",
      "properties": {
        "timestamp": {
          "$ref": "#/$defs/Timestamp"
        },
        "precision": {
          "$ref": "#/$defs/__schema27"
        },
        "until": {
          "$ref": "#/$defs/__schema28"
        },
        "untilPrecision": {
          "$ref": "#/$defs/__schema29"
        },
        "source": {
          "$ref": "#/$defs/__schema36"
        }
      },
      "required": [
        "timestamp"
      ]
    },
    "__schema36": {
      "$ref": "#/$defs/SourceRef"
    }
  }
}
