{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* Declarations come from tsc rather than tsup's bundled `dts`, so each .d.ts
       ships a .d.ts.map pointing back at the .ts it came from. Mirrors the
       arrangement in packages/ui. */
    "noEmit": false,
    "types": [],
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules", "test"]
}
