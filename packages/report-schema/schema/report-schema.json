{
  "$id": "https://aneural.dev/schema/report/0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "properties": {},
      "additionalProperties": {}
    },
    "components": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "$ref": "#/$defs/__schema0"
              },
              "kind": {
                "type": "string",
                "const": "timeline"
              },
              "title": {
                "type": "string"
              },
              "subtitle": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "scale": {
                "default": "ordinal",
                "type": "string",
                "enum": [
                  "ordinal",
                  "time"
                ]
              },
              "orientation": {
                "default": "horizontal",
                "type": "string",
                "enum": [
                  "horizontal",
                  "vertical"
                ]
              },
              "order": {
                "default": "ascending",
                "type": "string",
                "enum": [
                  "ascending",
                  "descending"
                ]
              },
              "labelUnit": {
                "type": "string",
                "enum": [
                  "second",
                  "minute",
                  "hour",
                  "day",
                  "week",
                  "month",
                  "year"
                ]
              },
              "lineVariant": {
                "$ref": "#/$defs/__schema1"
              },
              "events": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "$ref": "#/$defs/__schema2"
                    },
                    "timestamp": {
                      "$ref": "#/$defs/__schema3"
                    },
                    "precision": {
                      "$ref": "#/$defs/__schema4"
                    },
                    "title": {
                      "$ref": "#/$defs/__schema5"
                    },
                    "subtitle": {
                      "$ref": "#/$defs/__schema6"
                    },
                    "description": {
                      "$ref": "#/$defs/__schema7"
                    },
                    "lineVariant": {
                      "$ref": "#/$defs/__schema8"
                    },
                    "source": {
                      "$ref": "#/$defs/__schema9"
                    }
                  },
                  "required": [
                    "id",
                    "timestamp",
                    "title"
                  ]
                }
              }
            },
            "required": [
              "id",
              "kind",
              "title",
              "events"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "data",
    "components"
  ],
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1
        },
        "nodeId": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "bbox": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "l": {
                "type": "number"
              },
              "t": {
                "type": "number"
              },
              "r": {
                "type": "number"
              },
              "b": {
                "type": "number"
              }
            },
            "required": [
              "l",
              "t",
              "r",
              "b"
            ]
          }
        },
        "coordOrigin": {
          "default": "bottomleft",
          "type": "string",
          "enum": [
            "topleft",
            "bottomleft"
          ]
        },
        "pageSize": {
          "type": "object",
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "width",
            "height"
          ]
        },
        "chunkId": {
          "type": "string"
        },
        "quotedText": {
          "type": "string"
        }
      },
      "required": [
        "documentId",
        "nodeId",
        "page"
      ]
    },
    "__schema1": {
      "type": "string",
      "enum": [
        "solid",
        "dashed",
        "dotted",
        "none"
      ]
    },
    "__schema2": {
      "type": "string",
      "minLength": 1
    },
    "__schema3": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        }
      ]
    },
    "__schema4": {
      "type": "string",
      "enum": [
        "year",
        "month",
        "day",
        "hour",
        "minute",
        "second"
      ]
    },
    "__schema5": {
      "type": "string"
    },
    "__schema6": {
      "type": "string"
    },
    "__schema7": {
      "type": "string"
    },
    "__schema8": {
      "$ref": "#/$defs/__schema1"
    },
    "__schema9": {
      "$ref": "#/$defs/__schema0"
    }
  }
}
