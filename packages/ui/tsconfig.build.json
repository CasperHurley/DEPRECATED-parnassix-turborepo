{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* tsup's bundled `dts` cannot emit declaration maps (rollup-plugin-dts
       flattens everything into one file), which dead-ends Go to Definition in
       consuming apps. Emit declarations with tsc instead so each .d.ts ships a
       .d.ts.map pointing back at the .tsx it came from. */
    "noEmit": false,
    /* Match the old tsup dts settings: don't pull in ambient @types packages
       that the library itself never references. */
    "types": [],
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    /* tsc-alias resolves `@/*` against baseUrl; with baseUrl at the package root
       it looked for dist/src/* (which rootDir strips) and silently left the
       aliases unrewritten in the emitted .d.ts. Pointing baseUrl at src/ lines
       it up with rootDir so the rewrite actually happens. */
    "baseUrl": "./src",
    "paths": { "@/*": ["./*"] },
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  "exclude": ["dist", "build", "node_modules"]
}
